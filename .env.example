# ⚠️ PRODUCTION CHECKLIST — the defaults below are for LOCAL DEV. Before you
# expose this app on a real domain, set at minimum:
#   APP_ENV=production
#   APP_DEBUG=false            # or any error leaks stack traces, paths & config
#   APP_URL=https://your-domain # an https:// scheme here forces https URL
#                               # generation + HSTS, even behind a proxy/CDN
#   SESSION_SECURE_COOKIE=true # only send the session cookie over HTTPS
#   REGISTRATION_ENABLED=false # keep it single-user unless you mean to open it
# Also run `php artisan key:generate` so APP_KEY is set.
APP_NAME=MelaFreelance
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Money display: ISO 4217 currency code + BCP 47 locale for the Intl formatter.
# Defaults to euros formatted the Italian way (1.234,56 €). Switch freely, e.g.
# MONEY_CURRENCY=USD / MONEY_LOCALE=en-US or MONEY_CURRENCY=GBP / MONEY_LOCALE=en-GB.
MONEY_CURRENCY=EUR
MONEY_LOCALE=it-IT

# Single-user by default: provision the owner with `php artisan app:create-user`.
# Set to true to open public registration (multi-user / team installs).
REGISTRATION_ENABLED=false

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
MYSQL_EXTRA_OPTIONS=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true in production (HTTPS) so the session cookie is never sent over HTTP.
# Leave unset for local http:// dev, or the session cookie won't be stored.
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
